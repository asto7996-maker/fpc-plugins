# --- Скопируйте этот файл в .env и заполните своими значениями. ---
# Файл .env НЕ коммитится (см. .gitignore).

# === Игровой сервер ===
DWAR_BASE_URL=https://www.legendofdragons.ru
DWAR_COOKIE_DOMAIN=.legendofdragons.ru

# === Учётные данные (для повторного входа через форму, опционально) ===
DWAR_LOGIN=
DWAR_PASSWORD=

# === Cookie / сессии ===
# Список обязательных cookie через запятую (специфично для движка игры).
DWAR_REQUIRED_COOKIES=PHPSESSID,dwar_uid
DWAR_COOKIE_EXPIRY_LEEWAY=300
DWAR_COOKIE_ROTATION=1
DWAR_COOKIE_GLOB=*.json,*.txt

# === Браузер ===
DWAR_BROWSER_ENGINE=chromium
DWAR_HEADLESS=1
DWAR_DEFAULT_TIMEOUT_MS=15000
DWAR_NAV_TIMEOUT_MS=30000
# DWAR_PROXY=http://user:pass@host:port

# === Задержки (human-like), секунды ===
DWAR_DELAY_ACTION_MIN=0.4
DWAR_DELAY_ACTION_MAX=1.6
DWAR_DELAY_NAV_MIN=1.5
DWAR_DELAY_NAV_MAX=4.0
DWAR_DELAY_LOOP_MIN=8.0
DWAR_DELAY_LOOP_MAX=20.0

# === Логирование / Telegram ===
DWAR_LOG_LEVEL=INFO
DWAR_TELEGRAM_ENABLED=0
DWAR_TELEGRAM_TOKEN=
DWAR_TELEGRAM_CHAT_ID=
DWAR_TELEGRAM_LEVEL=ERROR
