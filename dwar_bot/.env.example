# ============================================================================
#  Пример конфигурации бота Dwar. Скопируйте в .env и заполните значения.
#  Все переменные опциональны — при отсутствии используются значения по умолчанию
#  из config.py.
# ============================================================================

# --- Игра ---
DWAR_BASE_URL=https://www.dwar.ru
DWAR_MAIN_PATH=/main.php
DWAR_INVENTORY_PATH=/inventory.php
DWAR_MAP_PATH=/map.php

# --- Браузер ---
DWAR_BROWSER_ENGINE=chromium          # chromium | firefox | webkit
DWAR_HEADLESS=true
DWAR_SLOW_MO_MS=0
DWAR_LOCALE=ru-RU
DWAR_TIMEZONE=Europe/Moscow
DWAR_VIEWPORT_W=1366
DWAR_VIEWPORT_H=768
DWAR_DEFAULT_TIMEOUT_MS=20000
DWAR_NAV_TIMEOUT_MS=30000
# DWAR_PROXY=http://user:pass@host:port
# DWAR_USER_DATA_DIR=./profile
# DWAR_USER_AGENT=

# --- Куки-сессии ---
# Каталог с файлами куки (*.json из Cookie-Editor или *.txt в формате Netscape).
DWAR_COOKIES_DIR=./sessions
# Либо явный путь к одному файлу (приоритетнее каталога).
# DWAR_COOKIES_FILE=./sessions/account1.json

# --- Логи ---
DWAR_LOGS_DIR=./logs
DWAR_LOG_FILE=bot.log
DWAR_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
DWAR_SCREENSHOTS_DIR=./screenshots
DWAR_SCREENSHOT_ON_ERROR=true

# --- Telegram-уведомления ---
DWAR_TG_ENABLED=false
DWAR_TG_TOKEN=
DWAR_TG_CHAT_ID=
DWAR_TG_MIN_LEVEL=WARNING

# --- Задержки (human-like) ---
DWAR_DELAY_ACTION_MIN=0.4
DWAR_DELAY_ACTION_MAX=1.4
DWAR_DELAY_LOOP_MIN=8.0
DWAR_DELAY_LOOP_MAX=20.0
DWAR_DELAY_READ_MIN=1.2
DWAR_DELAY_READ_MAX=3.5
DWAR_LONG_BREAK_CHANCE=0.05
DWAR_LONG_BREAK_MIN=60.0
DWAR_LONG_BREAK_MAX=300.0

# --- Бой ---
DWAR_HEAL_HP_PERCENT=45
DWAR_MIN_MANA_PERCENT=20
DWAR_MAX_ROUNDS=60
DWAR_USE_SPELLS=true
DWAR_USE_ELIXIRS=true

# --- Калдауны (сек) ---
DWAR_CD_ENERGY=300
DWAR_CD_PROFESSION=900
DWAR_CD_COMBAT=30
DWAR_CD_QUEST=120
DWAR_CD_STATS=60

# --- Отказоустойчивость ---
DWAR_MAX_RETRIES=3
DWAR_RETRY_BACKOFF=4.0
