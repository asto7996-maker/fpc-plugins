# DwarBot environment template (copy to .env)

# --- Game ---
DWAR_WORLD=w1
DWAR_LOG_LEVEL=INFO

# --- Telegram multi-admin ACL ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# Primary chat (also used as admin if TELEGRAM_ADMIN_IDS empty)
TELEGRAM_CHAT_ID=111111111
# Comma-separated Telegram user IDs allowed to control the bot
TELEGRAM_ADMIN_IDS=111111111,222222222
# Optional: extra chats that only receive notifications (no control)
# TELEGRAM_NOTIFY_CHAT_IDS=111111111,222222222,-1001234567890
# Allow group chats (default 0 = private DMs only; admins still checked by from.id)
TELEGRAM_ALLOW_GROUPS=0
TELEGRAM_MIN_LEVEL=WARNING

# --- Auto-heal (optional) ---
# CURSOR_API_KEY=
