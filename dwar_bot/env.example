# DwarBot environment template (copy to .env)

# --- Game ---
DWAR_WORLD=w1
DWAR_LOG_LEVEL=INFO

# --- Telegram multi-account ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# Primary owner (legacy cookies migrate into this user's slot)
TELEGRAM_CHAT_ID=111111111
# Each ID gets an ISOLATED game account (own cookies / character). Not shared.
TELEGRAM_ADMIN_IDS=111111111,222222222
TELEGRAM_ALLOW_GROUPS=0
TELEGRAM_MIN_LEVEL=WARNING

# --- Auto-heal (optional) ---
# CURSOR_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
