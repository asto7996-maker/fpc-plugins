+/** Remnawave rate-limits reissue; the button stays disabled this long. */
+const REVOKE_COOLDOWN_MS = 15 * 60 * 1000;
+/** Traffic counters are only re-read from the panel this often. */
+const TRAFFIC_CACHE_MS = 30 * 1000;
+
+/**
+ * Whole seconds left until `deadline` (epoch ms), ticking once a second.
+ *
+ * Cooldowns are held as a deadline rather than a decrementing counter so the
+ * ticking state can live in a leaf: the traffic cooldown runs for 30s and the
+ * reissue cooldown for 15 minutes, and a counter in the page component would
+ * re-render this whole route once a second for that entire window — a commit
+ * that lands mid-scroll and drops the frame.
+ */
+function useSecondsUntil(deadline: number | null): number {
+  const read = () => (deadline ? Math.max(0, Math.ceil((deadline - Date.now()) / 1000)) : 0);
+  const [left, setLeft] = useState(read);
+
+  useEffect(() => {
+    setLeft(read());
+    if (!deadline || read() <= 0) return;
+    const id = setInterval(() => {
+      const next = read();
+      setLeft(next);
+      if (next <= 0) clearInterval(id);
+    }, 1000);
+    return () => clearInterval(id);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [deadline]);
+
+  return left;
+}
+
+/** Isolated cooldown so the 1s tick doesn't re-render the whole page */
