+/* Touch / small screens: keep the gradient edge, drop the rotation.
+   `--border-angle` is a registered custom property feeding a conic-gradient,
+   so Chromium cannot composite the animation: every frame repaints the full
+   background of a card-sized element and re-rasters the scroll tiles under
+   it. On the Subscription route two of these run at once (connect-device CTA
+   + purchase CTA), which is what makes that page stutter under the finger in
+   the Telegram WebView. A fixed angle keeps the accent sheen at zero
+   per-frame cost — the same trade already made for backdrop-blur below
+   1024px. */
+@media (hover: none), (max-width: 1023px) {
+  .hover-border-gradient {
+    --border-angle: 135deg;
+    animation: none;
+  }
+}
+
+/* Same reason: `background-position` is a paint-only property, so the
+   unlimited-traffic bar repaints on every frame for its whole lifetime. */
+@media (hover: none), (max-width: 1023px) {
+  .animate-unlimited-flow {
+    animation: none;
+  }
+}
+
