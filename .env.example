# =============================================================================
# DwarBot — пример окружения
# Скопируйте:  cp .env.example .env
# Затем заполните значения. Файл .env НЕ коммитьте в git.
# =============================================================================

# --- Короткие алиасы (поддерживаются наравне с DWAR_*) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
DWAR_SERVER_URL=https://w2.dwar.ru
COOKIES_FILE_PATH=auth/cookies.json
HEADLESS_MODE=true

# --- Основные DWAR_* (рекомендуется) ---
DWAR_SERVER=w2
DWAR_HEADLESS=true
DWAR_COOKIES_FILE=auth/cookies.json
DWAR_LOG_FILE=bot.log
DWAR_LOG_LEVEL=INFO
DWAR_LOG_CONSOLE=true

# Основной режим FSM: farming | trading | quests | idle
DWAR_PRIMARY_MODE=farming
# DWAR_FARM_TARGETS=аметист,трава,руда

# Telegram remote control / алерты / crash-репорты
# Если TELEGRAM_* заполнены — Telegram включится автоматически
DWAR_TELEGRAM_ENABLED=true
DWAR_TELEGRAM_BOT_TOKEN=your_bot_token_here
DWAR_TELEGRAM_CHAT_ID=your_chat_id_here

# Аналитика / отчёты
DWAR_REPORT_INTERVAL_HOURS=12
# DWAR_DISCORD_WEBHOOK_URL=

# Задержки human-like (секунды) — не ставьте слишком низкие значения
# DWAR_DELAY_CLICK_MIN=0.35
# DWAR_DELAY_CLICK_MAX=1.2
# DWAR_DELAY_NAV_MIN=1.5
# DWAR_DELAY_NAV_MAX=4.0
# DWAR_DELAY_ACTION_MIN=0.8
# DWAR_DELAY_ACTION_MAX=2.5

# Опционально
# DWAR_USERNAME=
# DWAR_PASSWORD=
# DWAR_VIEWPORT_WIDTH=1920
# DWAR_VIEWPORT_HEIGHT=1080
# DWAR_SCREENSHOT_ON_ERROR=true
# DWAR_MAX_CONSECUTIVE_ERRORS=10
