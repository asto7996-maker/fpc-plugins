# Copy to .env and fill in real values. Never commit .env.

# Cursor Agent CLI (self-healing Level-2)
CURSOR_API_KEY=

# Gemini API — Auth keys (AQ.) and legacy Standard keys (AIza) both supported.
# New Google AI Studio keys use the AQ. prefix (authorization / auth keys).
GEMINI_API_KEY=
# Optional alias (google-genai also reads GOOGLE_API_KEY)
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Optional heal behaviour
# DWAR_RESTART_AFTER_HEAL=1
# DWAR_SERVICE_NAME=dwar_bot.service
