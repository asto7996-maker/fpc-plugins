# Единственное обязательное поле для старта бота.
# Остальное (admin, URL, интервал, таймаут) вводится в Telegram: /start → мастер
# или кнопка «⚙️ Настройки».
BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ниже — опционально (перекрываются settings.json из Telegram):
# TELEGRAM_ADMIN_ID=123456789
# BATTLE_URL=https://remanga.org/cards
# AUTO_BATTLE_INTERVAL_SEC=30
# SELECTOR_TIMEOUT_MS=30000
# USER_DATA_DIR=user_data
