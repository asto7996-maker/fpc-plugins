# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ваш Telegram user ID (узнать у @userinfobot)
# Бот будет отвечать ТОЛЬКО этому пользователю
TELEGRAM_ADMIN_ID=123456789

# URL страницы карточных боёв на remanga.org
# При необходимости замените на актуальный путь (например /cards, /card/battle и т.д.)
BATTLE_URL=https://remanga.org/cards

# Интервал автобоя в секундах (по умолчанию 90)
AUTO_BATTLE_INTERVAL_SEC=90

# Папка профиля браузера (persistent context)
USER_DATA_DIR=user_data

# Таймаут ожидания элементов на странице (мс)
SELECTOR_TIMEOUT_MS=20000
