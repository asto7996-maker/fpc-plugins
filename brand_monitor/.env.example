ADMIN_BOT_TOKEN=123456:ABC-DEF
ADMIN_IDS=123456789,987654321
DATABASE_PATH=./data/brand_monitor.db
LOG_LEVEL=INFO

# Typing simulation
TYPING_DELAY_MIN=2.0
TYPING_DELAY_MAX=6.0

# Reconnect backoff
BACKOFF_BASE=1.0
BACKOFF_MAX=60.0
BACKOFF_MAX_RETRIES=8

# Smart rate limits
MAX_REPLIES_PER_HOUR=4
MAX_REPLIES_PER_DAY=18
MIN_ACTION_PAUSE_SEC=600
MAX_ACTION_PAUSE_SEC=1500
PRE_REPLY_DELAY_MIN=45
PRE_REPLY_DELAY_MAX=90
FLOOD_WAIT_EXTRA_SEC=60

# Message filters
MIN_MESSAGE_LENGTH=10
MAX_MESSAGE_LENGTH=500

# Reply randomization
EMOJI_CHANCE=0.30
TYPO_ENABLED=false
CASE_RANDOMIZE=false
ZWSP_ENABLED=true
