# ============================================================
# Пример переменных окружения для VK VPN-бота
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
# ============================================================

# Токен сообщества ВКонтакте (Управление -> Настройки -> Работа с API)
VK_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID группы (без минуса). Можно узнать через API groups.getById по токену.
# Пример: 240702990
GROUP_ID=123456789

# URL базы данных:
# SQLite (по умолчанию):  sqlite+aiosqlite:///./data/vpn_bot.db
# PostgreSQL:             postgresql+asyncpg://user:password@localhost:5432/vpn_bot
DATABASE_URL=sqlite+aiosqlite:///./data/vpn_bot.db

# Длительность тестового периода в днях
TRIAL_DAYS=3

# Тип выдаваемых ключей: vless | outline | wireguard
VPN_KEY_TYPE=vless

# Контакт поддержки (ссылка или @username / id)
SUPPORT_URL=https://vk.com/im?sel=-123456789
SUPPORT_TEXT=Напишите нам в личные сообщения сообщества — поможем с настройкой.

# Шаблон VLESS-ссылки (плейсхолдеры: {uuid}, {user_id})
# Замените host/port/sni на параметры вашего сервера
VLESS_TEMPLATE=vless://{uuid}@vpn.example.com:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=www.cloudflare.com&fp=chrome&pbk=PUBLIC_KEY&sid=SHORT_ID&type=tcp#Bedolaga-VK-{user_id}

# Пул Outline-ключей (через запятую). Если пусто — генерируется демо-ключ
OUTLINE_KEYS=

# Текст приветствия (стиль «Бедолага»)
BOT_NAME=Бедолага VPN
WELCOME_TEXT=Привет! Я помогу подключить быстрый и стабильный VPN за пару кликов.