# ============================================================
# Пример переменных окружения для VK VPN-бота (Paskod / Bedolaga)
# cp .env.example .env
# ============================================================

# Токен сообщества ВКонтакте
VK_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID группы (без минуса). Для Paskod: 240702990
GROUP_ID=240702990

DATABASE_URL=sqlite+aiosqlite:///./data/vpn_bot.db
TRIAL_DAYS=3
RENEW_DAYS=30
# Бонус пригласившему за каждого нового реферала в VK-боте (+дней к подписке)
REFERRAL_INVITER_BONUS_DAYS=5
VPN_KEY_TYPE=vless

# Внешняя ссылка поддержки. Оставьте пустой, если поддержка живёт в этом же
# диалоге: ссылка на vk.com/im?sel=-GROUP_ID вернула бы пользователя туда,
# где он уже находится, поэтому такая кнопка скрывается автоматически.
SUPPORT_URL=
SUPPORT_TEXT=Мы на связи и поможем с настройкой Happ/VLESS, оплатой и ключом.
# Кому пересылать вопросы из «Помощи» (VK ID через запятую).
# Пусто — бот сам спросит управляющих сообщества через API.
# Если задан MAIN_ADMIN_VK_ID, тикеты идут только ему.
SUPPORT_ADMIN_IDS=

# Главный администратор: все тикеты поддержки + кнопка «🛠 Админ» в боте.
# VK ID @xylophaze = 634094665
MAIN_ADMIN_VK_ID=634094665
MAIN_ADMIN_USERNAME=xylophaze

# Локальный шаблон (используется только без BEDOLAGA_API_KEY)
VLESS_TEMPLATE=vless://{uuid}@vpn.example.com:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=www.cloudflare.com&fp=chrome&pbk=PUBLIC_KEY&sid=SHORT_ID&type=tcp#Paskod-VK-{user_id}
OUTLINE_KEYS=

BOT_NAME=Paskod VPN
WELCOME_TEXT=Привет! Я помогу подключить быстрый и стабильный VPN за пару кликов. Выдай ключ, импортируй в Happ — и готово.

# --- Интеграция с Bedolaga / Remnawave (реальные ключи) ---
BEDOLAGA_API_URL=https://cabinet.paskod.ru/api
# Web API key (заголовок X-API-Key). Создайте в админке Bedolaga → Tokens.
BEDOLAGA_API_KEY=
CABINET_URL=https://cabinet.paskod.ru
# Тот же CABINET_JWT_SECRET, что в .env Bedolaga-бота (для auto-login VK)
CABINET_JWT_SECRET=
