# Channel Reposter — USERBOT + admin panel
#
# Публикация идёт ТОЛЬКО через юзербот (api_id / api_hash).
# BOT_TOKEN — только панель управления в Telegram.

BOT_TOKEN=

# Можно задать заранее или через «🔐 Вход» в боте
API_ID=
API_HASH=
PHONE=
PASSWORD=
SESSION_NAME=reposter_userbot

# Публичный @username или id закрытого канала (35839961 / -10035839961)
SOURCE_CHANNEL=
# Назначение: @username / id / me (Избранное)
TARGET_CHANNEL=

# Ваш Telegram user id (пусто = доступен всем, кто напишет боту)
ADMIN_IDS=

DATABASE_PATH=data/reposter.db

# Интервал между циклами по умолчанию (минимум 5 сек).
# Задаётся один раз при первом запуске, дальше меняется кнопкой «⏱ Интервал».
DEFAULT_INTERVAL_SECONDS=3600
# Совместимость: если секунды не заданы, берутся часы
# DEFAULT_INTERVAL_HOURS=1

# Сколько публикаций за один цикл (альбом = 1 публикация)
DEFAULT_POSTS_PER_CYCLE=3

# Интервал в режиме «🚀 Догон», пока в источнике есть необработанные посты
DEFAULT_CATCHUP_SECONDS=60

# Пауза между публикациями внутри одного цикла (защита от flood)
POST_DELAY_MIN=2
POST_DELAY_MAX=4

# Оконный залив (несколько пар на одном юзерботе)
# Сколько секунд максимум крутить ОДНО окно, потом очередь идёт дальше
WINDOW_CYCLE_TIMEOUT=90
# Сколько секунд максимум на весь проход всех окон
PASS_TIMEOUT=180
# Сколько публикаций суммарно за один проход (делится между окнами)
PASS_PUBLISH_LIMIT=16
