# =============================================================================
# Пример файла окружения для Channel Reposter
# Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env
# =============================================================================

# --- Telegram Bot API (для админ-панели) ---
# Токен от @BotFather
BOT_TOKEN=8857836827:AAEzr3sZ_cBA3m9gh8k_u_yLfjWZCfFSPxk

# --- Telegram Client API (для юзербота / Pyrogram) ---
# Получить на https://my.telegram.org/apps
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Имя файла сессии Pyrogram (создаётся при первом запуске)
SESSION_NAME=reposter_userbot

# --- Каналы ---
# Источник: username без @, либо числовой ID (-100...)
SOURCE_CHANNEL=@source_channel
# Назначение: username без @, либо числовой ID (-100...)
TARGET_CHANNEL=@target_channel

# --- Администраторы ---
# Список Telegram user ID через запятую (узнать у @userinfobot)
ADMIN_IDS=123456789

# --- База данных ---
DATABASE_PATH=data/reposter.db

# --- Значения по умолчанию (можно менять через админ-панель) ---
# Интервал между циклами публикации (часы)
DEFAULT_INTERVAL_HOURS=6
# Сколько постов публиковать за один цикл
DEFAULT_POSTS_PER_CYCLE=5
# Пауза между постами внутри цикла (секунды, мин–макс)
POST_DELAY_MIN=3
POST_DELAY_MAX=5
