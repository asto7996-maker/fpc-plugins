# =============================================================================
# Пример файла окружения для Channel Reposter
# Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env
# =============================================================================

# --- Telegram Bot API (админ-панель + копирование постов) ---
# Токен от @BotFather
BOT_TOKEN=8857836827:AAEzr3sZ_cBA3m9gh8k_u_yLfjWZCfFSPxk

# --- Каналы (можно задать позже командами /set_source и /set_target) ---
# Источник: username без @ или с @, либо числовой ID (-100...)
SOURCE_CHANNEL=
# Назначение
TARGET_CHANNEL=

# --- Администраторы ---
# Список Telegram user ID через запятую (узнать у @userinfobot).
# Пусто = доступен всем (только для первого запуска).
ADMIN_IDS=

# --- Юзербот Pyrogram (опционально, для идеальных альбомов) ---
# Получить на https://my.telegram.org/apps
# Если не задано — используется Bot API (бот должен быть админом обоих каналов).
API_ID=
API_HASH=
SESSION_NAME=reposter_userbot
# auto | 1 | 0
USERBOT_MODE=auto

# --- База данных ---
DATABASE_PATH=data/reposter.db

# --- Значения по умолчанию (можно менять через админ-панель) ---
DEFAULT_INTERVAL_HOURS=6
DEFAULT_POSTS_PER_CYCLE=5
POST_DELAY_MIN=3
POST_DELAY_MAX=5
