# Channel Reposter — USERBOT + admin panel
#
# Публикация идёт ТОЛЬКО через юзербот (api_id / api_hash).
# BOT_TOKEN — только панель управления в Telegram.

BOT_TOKEN=

# Можно задать заранее или через «🔐 Вход» в боте
API_ID=
API_HASH=
PHONE=
PASSWORD=
SESSION_NAME=reposter_userbot

SOURCE_CHANNEL=
TARGET_CHANNEL=

# Ваш Telegram user id (пусто = доступен всем, кто напишет боту)
ADMIN_IDS=

DATABASE_PATH=data/reposter.db
DEFAULT_INTERVAL_HOURS=1
DEFAULT_POSTS_PER_CYCLE=3
POST_DELAY_MIN=2
POST_DELAY_MAX=4
